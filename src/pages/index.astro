---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ocasiones from '../components/Ocasiones.astro';
import Catalogo from '../components/Catalogo.astro';
import ComoPedir from '../components/ComoPedir.astro';
import BandaCta from '../components/BandaCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
---

<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Ocasiones />
    <Catalogo />
    <ComoPedir />
    <BandaCta />
  </main>
  <Footer />
  <WhatsAppFlotante />
</Base>
