---
import Icono from './ui/Icono.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';
---

<a
  href={enlaceWhatsApp()}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="group fixed right-4 bottom-4 z-40 grid size-14 place-items-center rounded-full bg-turquesa text-tinta ring-4 ring-white transition-transform hover:scale-105 sm:right-6 sm:bottom-6 sm:size-16"
>
  <span
    aria-hidden="true"
    class="absolute inset-0 rounded-full bg-turquesa opacity-60 motion-safe:animate-ping motion-safe:[animation-duration:2.5s]"
  ></span>
  <Icono nombre="whatsapp" class="relative size-7 sm:size-8" />
</a>
