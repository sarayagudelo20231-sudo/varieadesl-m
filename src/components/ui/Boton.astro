---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  variante?: 'morado' | 'amarillo' | 'contorno' | 'blanco';
  tamano?: 'sm' | 'md' | 'lg';
  /** Abre en otra pestaña (WhatsApp, Instagram). */
  externo?: boolean;
};

const { variante = 'morado', tamano = 'md', externo = false, class: clase, ...resto } = Astro.props;

const variantes = {
  morado: 'border-transparent bg-morado text-white hover:bg-morado-oscuro',
  amarillo: 'border-transparent bg-amarillo text-tinta hover:bg-amarillo-oscuro',
  contorno: 'border-morado bg-transparent text-morado hover:bg-morado hover:text-white',
  blanco: 'border-transparent bg-white text-morado hover:bg-fondo',
};

const tamanos = {
  sm: 'gap-1.5 px-4 py-2 text-sm',
  md: 'gap-2 px-5 py-2.5 text-[0.95rem]',
  lg: 'gap-2 px-7 py-3.5 text-base',
};

const atributosExternos = externo ? { target: '_blank', rel: 'noopener' } : {};
---

<a
  class:list={[
    'inline-flex items-center justify-center rounded-full border-2 font-display font-extrabold whitespace-nowrap transition-colors duration-200',
    variantes[variante],
    tamanos[tamano],
    clase,
  ]}
  {...atributosExternos}
  {...resto}
>
  <slot />
</a>
