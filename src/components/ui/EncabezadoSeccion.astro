---
interface Props {
  /** Texto pequeño en mayúsculas, estilo "02 · CATÁLOGO" del manual. */
  eyebrow: string;
  titulo: string;
  descripcion?: string;
  centrado?: boolean;
  id?: string;
}

const { eyebrow, titulo, descripcion, centrado = false, id } = Astro.props;
---

<div class:list={['max-w-2xl', centrado && 'mx-auto text-center']}>
  <p class="font-display text-xs font-extrabold tracking-[0.2em] text-morado uppercase sm:text-sm sm:tracking-[0.3em]">
    {eyebrow}
  </p>
  <h2 id={id} class="mt-4 text-3xl leading-[1.1] font-black sm:text-4xl lg:text-5xl">{titulo}</h2>
  {descripcion && <p class="mt-5 text-base sm:text-lg">{descripcion}</p>}
</div>
