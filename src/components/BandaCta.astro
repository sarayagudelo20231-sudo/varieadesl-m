---
import { Image } from 'astro:assets';
import logoNegativo from '../assets/brand/logo-negativo.png';
import Boton from './ui/Boton.astro';
import Icono from './ui/Icono.astro';
import Brillos from './graficos/Brillos.astro';
import Corazon from './graficos/Corazon.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { negocio } from '../data/negocio';

const mensaje = `Hola ${negocio.nombre} 💜, tengo una idea para un regalo y quiero que me ayuden a armarlo.`;
---

<section aria-labelledby="titulo-cta" class="px-4 sm:px-6">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-morado px-6 py-14 sm:px-12 md:py-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <Brillos class="absolute top-6 left-6 size-12 motion-safe:animate-titilar" />
      <Corazon variante="linea-turquesa" class="absolute bottom-8 left-[42%] size-8 rotate-12" />
      <Brillos color="blanco" class="absolute right-8 bottom-6 size-10 rotate-180 opacity-70" />
    </div>

    <div class="relative grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div>
        <h2 id="titulo-cta" class="text-3xl leading-tight font-black text-white sm:text-4xl lg:text-5xl">
          ¿Tienes una idea especial?
          <span class="mt-2 block font-script text-[0.85em] font-normal text-amarillo">La armamos contigo.</span>
        </h2>
        <p class="mt-5 max-w-xl text-lg text-white/90">
          Cuéntanos para quién es, la ocasión y tu presupuesto. Te respondemos rápido con opciones.
        </p>
        <Boton href={enlaceWhatsApp(mensaje)} variante="amarillo" tamano="lg" externo class="mt-8">
          <Icono nombre="whatsapp" class="size-5" />
          Escribir por WhatsApp
        </Boton>
      </div>

      <!-- Versión en negativo del logo: uso indicado sobre fondo morado -->
      <Image src={logoNegativo} alt="" widths={[260, 520]} sizes="260px" class="hidden h-auto w-[260px] md:block" />
    </div>
  </div>
</section>
