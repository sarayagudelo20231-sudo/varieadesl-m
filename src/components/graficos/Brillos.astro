---
/** Trazos de brillo de la marca (lámina 06): tres rayitas redondeadas. */
interface Props {
  color?: 'amarillo' | 'turquesa' | 'blanco' | 'lila';
  class?: string;
}

const { color = 'amarillo', class: clase = 'size-12' } = Astro.props;

const colores = {
  amarillo: '#FFD93B',
  turquesa: '#2ED6C3',
  blanco: '#FFFFFF',
  lila: '#C7B8FF',
};
---

<svg
  class:list={['shrink-0', clase]}
  viewBox="0 0 48 48"
  fill="none"
  stroke={colores[color]}
  stroke-width="5"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M10 33.5 20.5 29"></path>
  <path d="M13 13.5 21.5 21"></path>
  <path d="M30.5 6.5 29 17"></path>
</svg>
