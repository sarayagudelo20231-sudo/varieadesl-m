---
/**
 * Corazones de la marca (lámina 06 · Elementos gráficos).
 * - relleno:        turquesa con borde morado
 * - linea-turquesa: solo contorno turquesa (el del logo junto a "LyL")
 * - linea-morado:   solo contorno morado
 * - amarillo:       relleno amarillo (el del centro del moño)
 */
interface Props {
  variante?: 'relleno' | 'linea-turquesa' | 'linea-morado' | 'amarillo';
  class?: string;
}

const { variante = 'relleno', class: clase = 'size-8' } = Astro.props;

const estilos = {
  relleno: { fill: '#2ED6C3', stroke: '#4E2EC5', width: 5 },
  'linea-turquesa': { fill: 'none', stroke: '#2ED6C3', width: 5.5 },
  'linea-morado': { fill: 'none', stroke: '#6C4CE8', width: 5 },
  amarillo: { fill: '#FFD93B', stroke: 'none', width: 0 },
};
const e = estilos[variante];
---

<svg class:list={['shrink-0', clase]} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <path
    d="M24 41.5C14.5 35 6.5 27.6 6.8 18.6 7 12.3 11.6 8 17 8.3c3.3.2 5.6 2 7 4.6 1.4-2.6 3.8-4.4 7.2-4.6 5.3-.2 9.8 4.1 9.9 10.4.2 9-7.6 16.4-17.1 22.8z"
    fill={e.fill}
    stroke={e.stroke}
    stroke-width={e.width}
    stroke-linejoin="round"></path>
</svg>
