---
/**
 * Ilustración de caja de regalo en colores de marca.
 * Se muestra mientras una ancheta no tenga foto real.
 */
interface Props {
  /** Variante de color (0, 1 o 2). */
  tono?: number;
  nombre: string;
}

const { tono = 0, nombre } = Astro.props;

const tonos = [
  { fondo: '#F6F3FF', caja: '#6C4CE8', tapa: '#5634D6', cinta: '#FFD93B', corazon: '#2ED6C3' },
  { fondo: '#FFF7D6', caja: '#2ED6C3', tapa: '#22BFAD', cinta: '#6C4CE8', corazon: '#FFD93B' },
  { fondo: '#E9FBF8', caja: '#C7B8FF', tapa: '#B3A0FA', cinta: '#6C4CE8', corazon: '#FFD93B' },
];
const t = tonos[tono % tonos.length];
---

<svg viewBox="0 0 400 300" class="size-full" role="img" aria-label={`Ilustración de la ancheta ${nombre}`}>
  <rect width="400" height="300" fill={t.fondo}></rect>
  <!-- brillos -->
  <g stroke="#FFD93B" stroke-width="9" stroke-linecap="round">
    <path d="M96 92 116 106"></path>
    <path d="M84 138h24"></path>
    <path d="M304 92 284 106"></path>
    <path d="M316 138h-24"></path>
  </g>
  <!-- corazones -->
  <path
    d="M76 222c-9-6-16-12.5-15.8-20.5.2-5.6 4.3-9.4 9.1-9.1 2.9.2 5 1.8 6.7 4.1 1.2-2.3 3.4-3.9 6.4-4.1 4.7-.2 8.7 3.6 8.8 9.2.2 8-6.8 14.4-15.2 20.4z"
    fill="none"
    stroke="#6C4CE8"
    stroke-width="4.5"
    stroke-linejoin="round"></path>
  <path
    d="M326 214c-7-4.7-12.5-9.8-12.3-16 .1-4.4 3.3-7.3 7.1-7.1 2.3.1 3.9 1.4 5.2 3.2.9-1.8 2.6-3 5-3.2 3.7-.1 6.8 2.8 6.9 7.2.1 6.2-5.3 11.2-11.9 15.9z"
    fill={t.corazon}></path>
  <!-- caja -->
  <rect x="128" y="152" width="144" height="104" rx="16" fill={t.caja}></rect>
  <rect x="116" y="126" width="168" height="36" rx="13" fill={t.tapa}></rect>
  <rect x="189" y="126" width="22" height="130" fill={t.cinta}></rect>
  <!-- moño -->
  <g fill="none" stroke={t.cinta} stroke-width="11" stroke-linejoin="round" stroke-linecap="round">
    <path d="M200 124c-12-30-46-42-50-22-3 15 28 22 50 22z"></path>
    <path d="M200 124c12-30 46-42 50-22 3 15-28 22-50 22z"></path>
  </g>
  <path
    d="M200 136c-7.5-5-13-10-12.8-16.4.2-4.4 3.4-7.5 7.3-7.3 2.4.2 4 1.4 5.5 3.3 1-1.9 2.7-3.1 5.2-3.3 3.8-.1 7 2.9 7.1 7.3.1 6.4-5.5 11.5-12.3 16.4z"
    fill={t.corazon}
    stroke="#FFFFFF"
    stroke-width="3"></path>
</svg>
