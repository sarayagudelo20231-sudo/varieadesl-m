---
import LogoHorizontal from './LogoHorizontal.astro';
import Boton from './ui/Boton.astro';
import Icono from './ui/Icono.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { negocio } from '../data/negocio';

const enlaces = [
  { href: '#ocasiones', texto: 'Ocasiones' },
  { href: '#catalogo', texto: 'Catálogo' },
  { href: '#como-pedir', texto: 'Cómo pedir' },
  { href: '#contacto', texto: 'Contacto' },
];
---

<header class="sticky top-0 z-40 border-b border-lila/50 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#inicio" aria-label={`${negocio.nombre}, ir al inicio`} class="shrink-0">
      <LogoHorizontal conEslogan />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-7 font-display text-[0.95rem] font-extrabold text-tinta">
        {
          enlaces.map((e) => (
            <li>
              <a href={e.href} class="transition-colors hover:text-morado">
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <span class="hidden sm:block">
        <Boton href={enlaceWhatsApp()} variante="amarillo" tamano="sm" externo>
          <Icono nombre="whatsapp" class="size-4.5" />
          Pedir ahora
        </Boton>
      </span>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full text-tinta transition-colors hover:bg-fondo md:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-boton
      >
        <span class="sr-only" data-menu-etiqueta>Abrir menú</span>
        <Icono nombre="menu" class="size-6" data-icono="abrir" />
        <Icono nombre="cerrar" class="hidden size-6" data-icono="cerrar" />
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-lila/50 bg-white md:hidden" data-menu>
    <nav aria-label="Menú móvil" class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
      <ul class="flex flex-col font-display text-lg font-extrabold text-tinta">
        {
          enlaces.map((e) => (
            <li>
              <a href={e.href} class="block rounded-2xl px-3 py-3 hover:bg-fondo hover:text-morado">
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <Boton href={enlaceWhatsApp()} variante="amarillo" externo class="mt-3 w-full">
        <Icono nombre="whatsapp" />
        Pedir por WhatsApp
      </Boton>
    </nav>
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (boton && menu) {
    const etiqueta = boton.querySelector('[data-menu-etiqueta]');
    const iconoAbrir = boton.querySelector('[data-icono="abrir"]');
    const iconoCerrar = boton.querySelector('[data-icono="cerrar"]');

    const cambiar = (abierto: boolean) => {
      boton.setAttribute('aria-expanded', String(abierto));
      menu.classList.toggle('hidden', !abierto);
      iconoAbrir?.classList.toggle('hidden', abierto);
      iconoCerrar?.classList.toggle('hidden', !abierto);
      if (etiqueta) etiqueta.textContent = abierto ? 'Cerrar menú' : 'Abrir menú';
    };

    boton.addEventListener('click', () => cambiar(boton.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => cambiar(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cambiar(false);
        boton.focus();
      }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) cambiar(false);
    });
  }
</script>
